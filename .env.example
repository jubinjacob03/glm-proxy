# Copy to .env and fill in. .env is gitignored — never commit real values.

# Upstream Z.AI account token. Leave empty to use anonymous guest sessions.
ZAI_TOKEN=

# API key clients must present as `Authorization: Bearer <token>` (or x-api-key).
# Comma-separated to accept several keys.
AUTH_TOKEN=Jubin,unlimited

# Translate tools and non-user roles for Z.AI compatibility.
AGENT_MODE=true

# Listener. Bind 127.0.0.1 unless you intend to expose the bridge.
HOST=127.0.0.1
PORT=3007

# debug logs every upstream SSE line and every request/response body, which is
# expensive on the streaming path. Use info unless you are debugging.
LOG_LEVEL=info
LOG_DIR=logs
LOG_CONSOLE_WIDTH=150
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=7

# Device token replenishment.
TOKEN_MONITOR=true
TOKEN_MIN=50
TOKEN_COLLECT_BATCH=2
TOKEN_MONITOR_INTERVAL_SECONDS=60

# Captcha parameter cache. Each cached parameter costs one device token and
# expires unused, so depth and idle window set the idle token burn.
CAPTCHA_CACHE_SIZE=2
CAPTCHA_TTL_SECONDS=75
CAPTCHA_IDLE_SECONDS=120

# Concurrency and limits.
UPSTREAM_MAX_CONNS=128
MAX_REQUEST_BYTES=33554432
SESSION_POOL_SIZE=5
SESSION_ACQUIRE_TIMEOUT=10
